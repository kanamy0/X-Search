# X (Twitter) API v2 Bearer Token
# https://developer.x.com/ で App を作成し、Bearer Token を取得してください。
X_BEARER_TOKEN=

# Google Gemini API Key
# https://aistudio.google.com/app/apikey で取得してください。
GEMINI_API_KEY=

# 任意設定 (未設定時は config.py のデフォルト値が使われます)
# GEMINI_MODEL=gemini-2.5-flash
# DATABASE_URL=sqlite:///x_search.db
# LOG_LEVEL=INFO
